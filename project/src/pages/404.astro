---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page Not Found | Schwab & Co. Holdings" description="The page you're looking for doesn't exist.">
  <section class="relative isolate overflow-hidden bg-ink-900 pt-32 pb-24 sm:pt-40">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_50%_50%,rgba(255,176,31,0.15),transparent)]"></div>
    <div class="stall-pattern absolute inset-x-0 top-0 h-24 opacity-30"></div>

    <div class="mx-auto max-w-2xl px-5 text-center sm:px-8">
      <p class="font-display text-7xl font-extrabold text-brand-400 sm:text-8xl">404</p>
      <h1 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        This lot doesn't exist.
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-white/70">
        The page you're looking for has been moved, renamed, or never existed. Let's get you back on
        the right line.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="group btn-primary">
          Back to home
          <Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" />
        </a>
        <a href="/services" class="btn-ghost">Browse services</a>
      </div>
    </div>
  </section>
</BaseLayout>
