---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CTASection from '../../components/CTASection.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services, getService } from '../../data/services';
import { locations } from '../../data/locations';

export async function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = getService(slug!);

if (!service) {
  return Astro.redirect('/404');
}

const otherServices = services.filter((s) => s.slug !== service.slug).slice(0, 3);
const nearbyCities = locations.slice(0, 4);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout title={service.metaTitle} description={service.metaDescription} ogImage={service.hero}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <section class="relative isolate overflow-hidden bg-ink-900 pt-32 pb-20 sm:pt-40 sm:pb-28">
    <div class="absolute inset-0 -z-10">
      <img src={service.hero} alt={service.title} class="h-full w-full object-cover opacity-25" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-br from-ink-900 via-ink-900/90 to-ink-900/50"></div>
    </div>
    <div class="lane-line absolute inset-x-0 bottom-0 opacity-50"></div>

    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <nav class="flex items-center gap-2 text-sm text-white/50">
        <a href="/" class="hover:text-brand-400">Home</a>
        <Icon name="chevron" class="h-4 w-4" />
        <a href="/services" class="hover:text-brand-400">Services</a>
        <Icon name="chevron" class="h-4 w-4" />
        <span class="text-white/80">{service.title}</span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <span class="eyebrow-dark">{service.tagline}</span>
          <h1 class="mt-4 font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl">
            {service.title}
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">{service.description}</p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="/contact" class="group btn-primary">
              Get a free quote
              <Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" />
            </a>
            <a href="/contact" class="btn-ghost">
              <Icon name="phone" class="h-4 w-4" />
              Call instead
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur shadow-2xl shadow-black/40">
            <div class="stall-pattern absolute inset-x-0 top-0 h-16 rounded-t-3xl opacity-40"></div>
            <h3 class="relative font-display text-lg font-bold text-white">What's included</h3>
            <ul class="relative mt-4 space-y-3 text-sm text-white/80">
              {service.bullets.map((b) => (
                <li class="flex items-start gap-3">
                  <Icon name="check-circle" class="mt-0.5 h-5 w-5 flex-none text-brand-400" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="eyebrow">Our process</span>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          How {service.title.toLowerCase()} gets done.
        </h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {service.process.map((p, i) => (
          <div class="rounded-2xl border border-ink-700/10 bg-white p-6 shadow-sm">
            <span class="font-display text-3xl font-extrabold text-brand-400">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-display text-lg font-bold text-ink-900">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700/80">{p.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {service.gallery.length > 0 && (
    <section class="py-20 sm:py-28" style="background-color: #f8fafc;">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <span class="eyebrow">On the job</span>
          <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
            Recent {service.title.toLowerCase()} work
          </h2>
        </div>
        <div class={`mt-14 grid gap-6 ${service.gallery.length >= 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}`}>
          {service.gallery.map((g) => (
            <div class="overflow-hidden rounded-2xl shadow-lg shadow-ink-900/10">
              <img src={g} alt={`${service.title} work`} class="h-64 w-full object-cover" loading="lazy" />
            </div>
          ))}
        </div>
        <p class="mt-6 text-center text-xs text-ink-700/50">Placeholder photos for layout. Real project photos coming soon.</p>
      </div>
    </section>
  )}

  <section class="bg-ink-900 py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="eyebrow-dark">Where we work</span>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          {service.title} across central Michigan
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-white/70">
          Dispatched from Rosebush. We serve these towns and everywhere in between.
        </p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {nearbyCities.map((l) => (
          <a href={`/locations/${l.slug}`} class="group flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-4 transition hover:border-brand-400/40 hover:bg-white/10">
            <div>
              <p class="font-display font-bold text-white">{l.city}</p>
              <p class="text-xs text-white/50">{l.distanceFromRosebush}</p>
            </div>
            <Icon name="arrow-right" class="h-4 w-4 text-brand-400 transition group-hover:translate-x-1" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <div class="text-center">
        <span class="eyebrow">FAQ</span>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {service.title} questions, answered.
        </h2>
      </div>
      <div class="mt-12 space-y-4">
        {service.faqs.map((f) => (
          <details class="group rounded-2xl border border-ink-700/10 bg-white p-6 shadow-sm [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4">
              <span class="font-display text-lg font-bold text-ink-900">{f.q}</span>
              <span class="inline-flex h-8 w-8 flex-none items-center justify-center rounded-full bg-brand-100 text-brand-600 transition group-open:rotate-45">
                <Icon name="chevron" class="h-4 w-4 rotate-90" />
              </span>
            </summary>
            <p class="mt-4 text-base leading-relaxed text-ink-700/80">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28" style="background-color: #f8fafc;">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="eyebrow">More services</span>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          Other parking lot work
        </h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {otherServices.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CTASection title={`Ready to book ${service.title.toLowerCase()}?`} />
</BaseLayout>
