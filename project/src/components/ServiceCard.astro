---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

export interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="card group relative overflow-hidden">
  <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600 transition group-hover:bg-brand-400 group-hover:text-ink-900">
    <Icon name={service.icon} class="h-6 w-6" strokeWidth={2.2} />
  </span>
  <h3 class="mt-5 font-display text-xl font-bold text-ink-900">{service.title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-ink-700/80">{service.short}</p>
  <ul class="mt-5 space-y-2">
    {service.bullets.slice(0, 3).map((b) => (
      <li class="flex items-center gap-2 text-sm text-ink-700">
        <Icon name="check-circle" class="h-4 w-4 text-brand-500" />
        {b}
      </li>
    ))}
  </ul>
  <a href={`/services/${service.slug}`} class="mt-6 inline-flex items-center gap-1 text-sm font-bold text-brand-600 transition group-hover:gap-2">
    Learn more
    <Icon name="arrow-right" class="h-4 w-4" />
  </a>
</article>
