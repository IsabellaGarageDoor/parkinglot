---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
  data-scrolled-class="bg-ink-900/95 backdrop-blur shadow-lg shadow-black/20"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
    <a href="/" class="flex items-center gap-2.5 group">
      <span class="relative inline-flex h-9 w-9 items-center justify-center rounded-lg bg-brand-400 text-ink-900 shadow-md shadow-brand-500/30 transition group-hover:rotate-3">
        <Icon name="paint-roller" class="h-5 w-5" strokeWidth={2.4} />
      </span>
      <span class="font-display text-lg font-extrabold tracking-tight text-white sm:text-xl">
        Pavement <span class="text-brand-400">Preservation</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {site.nav.map((n) => (
        <a href={n.href} class="text-sm font-medium text-white/80 transition hover:text-brand-400">
          {n.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <a href={site.phoneHref} class="flex items-center gap-2 text-sm font-semibold text-white/90 hover:text-brand-400">
        <Icon name="phone" class="h-4 w-4" />
        {site.phone}
      </a>
      <a href="/contact" class="rounded-full bg-brand-400 px-5 py-2.5 text-sm font-bold text-ink-900 shadow-md shadow-brand-500/30 transition hover:bg-brand-300">
        Free Estimate
      </a>
    </div>

    <button
      id="menu-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-white md:hidden"
      aria-label="Toggle menu"
    >
      <Icon name="menu" class="h-6 w-6 menu-open-icon" />
      <Icon name="x" class="h-6 w-6 menu-close-icon hidden" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-ink-900/98 backdrop-blur md:hidden">
    <div class="mx-auto flex max-w-7xl flex-col gap-1 px-5 py-3">
      {site.nav.map((n) => (
        <a href={n.href} class="rounded-lg px-3 py-3 text-base font-medium text-white/85 hover:bg-white/5 hover:text-brand-400">
          {n.label}
        </a>
      ))}
      <a href="/contact" class="mt-2 rounded-full bg-brand-400 px-5 py-3 text-center text-base font-bold text-ink-900">
        Free Estimate
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.querySelector('.menu-open-icon');
  const closeIcon = document.querySelector('.menu-close-icon');

  const onScroll = () => {
    const scrolledClass = header?.dataset.scrolledClass ?? '';
    if (window.scrollY > 24) {
      header?.classList.add(...scrolledClass.split(' '));
    } else {
      header?.classList.remove(...scrolledClass.split(' '));
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
