---
export interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'h-6 w-6', strokeWidth = 2 } = Astro.props;

const icons: Record<string, string> = {
  'paint-roller': `<path d="M3 14h12a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4z"/><path d="M19 5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3h14V5z"/><path d="M19 8h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-2"/>`,
  hammer: `<path d="M15 12 5 22l-3-3 10-10"/><path d="M13 9l-2-2 5-5 2 2-5 5z"/><path d="M14 8l2 2"/>`,
  'square': `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/>`,
  sign: `<path d="M12 2v20"/><path d="M5 4h14l-2 4 2 4H5l2-4-2-4z"/>`,
  accessibility: `<circle cx="12" cy="4" r="2"/><path d="M12 6v6"/><path d="M8 9h8"/><path d="M9 22l3-7 3 7"/>`,
  box: `<path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/>`,
  triangle: `<path d="M12 3l9 16H3L12 3z"/>`,
  phone: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>`,
  mail: `<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>`,
  'map-pin': `<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>`,
  clock: `<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>`,
  check: `<path d="M20 6 9 17l-5-5"/>`,
  'check-circle': `<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>`,
  shield: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
  arrow: `<path d="M5 12h14M13 6l6 6-6 6"/>`,
  'arrow-right': `<path d="M5 12h14M13 6l6 6-6 6"/>`,
  star: `<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>`,
  quote: `<path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2-2-2H4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2-2-2h-4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2h.75c0 0 .25 0 .25.25v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/>`,
  menu: `<path d="M4 6h16M4 12h16M4 18h16"/>`,
  x: `<path d="M18 6 6 18M6 6l12 12"/>`,
  chevron: `<path d="m9 18 6-6-6-6"/>`,
  truck: `<path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>`,
  ruler: `<path d="M3 8l5-5 13 13-5 5L3 8z"/><path d="M7 4l2 2M9 6l2 2M11 8l2 2M13 10l2 2M15 12l2 2"/>`,
};

const path = icons[name] ?? icons['check'];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={path}
/>
