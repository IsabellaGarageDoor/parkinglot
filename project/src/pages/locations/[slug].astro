---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import LocationCard from '../../components/LocationCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import { locations, getLocation } from '../../data/locations';
import { services } from '../../data/services';

export async function getStaticPaths() {
  return locations.map((l) => ({ params: { slug: l.slug } }));
}

const { slug } = Astro.params;
const location = getLocation(slug!);

if (!location) {
  return Astro.redirect('/404');
}

const otherLocations = locations.filter((l) => l.slug !== location.slug).slice(0, 3);
---

<BaseLayout title={location.metaTitle} description={location.metaDescription} ogImage={location.hero}>
  <section class="relative isolate overflow-hidden bg-ink-900 pt-32 pb-20 sm:pt-40 sm:pb-28">
    <div class="absolute inset-0 -z-10">
      <img src={location.hero} alt={location.city} class="h-full w-full object-cover opacity-25" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-br from-ink-900 via-ink-900/90 to-ink-900/50"></div>
    </div>
    <div class="lane-line absolute inset-x-0 bottom-0 opacity-50"></div>

    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <nav class="flex items-center gap-2 text-sm text-white/50">
        <a href="/" class="hover:text-brand-400">Home</a>
        <Icon name="chevron" class="h-4 w-4" />
        <a href="/locations" class="hover:text-brand-400">Service Areas</a>
        <Icon name="chevron" class="h-4 w-4" />
        <span class="text-white/80">{location.city}</span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <span class="eyebrow-dark">
            <Icon name="map-pin" class="h-3.5 w-3.5" /> {location.distanceFromRosebush}
          </span>
          <h1 class="mt-4 font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl">
            Parking lot maintenance in <span class="text-brand-400">{location.city}</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">{location.blurb}</p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="/contact" class="group btn-primary">
              Get a free quote
              <Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" />
            </a>
            <a href="/contact" class="btn-ghost">
              <Icon name="phone" class="h-4 w-4" />
              Call instead
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur shadow-2xl shadow-black/40">
            <div class="stall-pattern absolute inset-x-0 top-0 h-16 rounded-t-3xl opacity-40"></div>
            <h3 class="relative font-display text-lg font-bold text-white">Nearby landmarks</h3>
            <ul class="relative mt-4 space-y-3 text-sm text-white/80">
              {location.nearbyLandmarks.map((lm) => (
                <li class="flex items-start gap-3">
                  <Icon name="map-pin" class="mt-0.5 h-5 w-5 flex-none text-brand-400" />
                  <span>{lm}</span>
                </li>
              ))}
            </ul>
            <div class="relative mt-5 border-t border-white/10 pt-4 text-sm text-white/60">
              <p><span class="font-semibold text-white/80">County:</span> {location.county}</p>
              <p class="mt-1"><span class="font-semibold text-white/80">Home base:</span> Rosebush, MI</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="eyebrow">What we do here</span>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          Services in {location.city}
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-700/80">
          Every service we offer is available in {location.city}. Click any service for process, FAQs, and a free quote.
        </p>
      </div>
      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}`} class="group flex items-center justify-between rounded-xl border border-ink-700/10 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-500/10">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
                <Icon name={s.icon} class="h-5 w-5" strokeWidth={2.2} />
              </span>
              <span class="font-display font-bold text-ink-900">{s.title}</span>
            </div>
            <Icon name="arrow-right" class="h-4 w-4 text-brand-600 transition group-hover:translate-x-1" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-ink-900 py-20 sm:py-28">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_20%_100%,rgba(255,176,31,0.15),transparent)]"></div>
    <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:items-start">
      <div>
        <span class="eyebrow-dark">Free estimate</span>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Get a quote for your {location.city} lot
        </h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-white/70">
          Tell us about your project and we'll send a written quote within 48 hours. We'll pre-fill
          your city for you.
        </p>
        <ul class="mt-6 space-y-3 text-white/80">
          <li class="flex items-center gap-3"><Icon name="check-circle" class="h-5 w-5 text-brand-400" /> Free site walk in {location.city}</li>
          <li class="flex items-center gap-3"><Icon name="check-circle" class="h-5 w-5 text-brand-400" /> Written quote within 48 hours</li>
          <li class="flex items-center gap-3"><Icon name="check-circle" class="h-5 w-5 text-brand-400" /> No obligation, no surprise add-ons</li>
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>

  <section class="py-20 sm:py-28" style="background-color: #f8fafc;">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="eyebrow">More service areas</span>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          Other towns we serve
        </h2>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {otherLocations.map((l) => <LocationCard location={l} />)}
      </div>
      <div class="mt-10 text-center">
        <a href="/locations" class="inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:gap-3">
          See all service areas
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
