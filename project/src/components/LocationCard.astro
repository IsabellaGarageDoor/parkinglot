---
import Icon from './Icon.astro';
import type { Location } from '../data/locations';

export interface Props {
  location: Location;
}

const { location } = Astro.props;
---

<article class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/5">
  <div class="relative h-44 overflow-hidden">
    <img
      src={location.img}
      alt={location.city}
      class="h-full w-full object-cover opacity-70 transition duration-500 group-hover:scale-105 group-hover:opacity-90"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/30 to-transparent"></div>
  </div>
  <div class="p-5">
    <div class="flex items-center gap-2 text-brand-400">
      <Icon name="map-pin" class="h-4 w-4" />
      <span class="text-xs font-semibold uppercase tracking-wider">{location.distanceFromRosebush}</span>
    </div>
    <h3 class="mt-2 font-display text-lg font-bold text-white">{location.city}</h3>
    <p class="mt-1 text-xs text-white/50">{location.county}</p>
    <a href={`/locations/${location.slug}`} class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-white/80 transition hover:text-brand-400">
      See service details
      <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </div>
</article>
