---
import Icon from './Icon.astro';
import { site } from '../data/site';

export interface Props {
  title?: string;
  desc?: string;
}

const {
  title = 'Ready to make your lot look like new?',
  desc = 'Tell us about your project and we\'ll send a written quote within 48 hours — no obligation, no surprise add-ons.',
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink-900 py-20 sm:py-24">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_50%_50%,rgba(255,176,31,0.18),transparent)]"></div>
  <div class="ada-hatch absolute inset-x-0 top-0 h-2 opacity-80"></div>

  <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
    <h2 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-white/70">{desc}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href="/contact" class="group btn-primary">
        Get a free quote
        <Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" />
      </a>
      <a href={site.phoneHref} class="btn-ghost">
        <Icon name="phone" class="h-4 w-4" />
        {site.phone}
      </a>
    </div>
  </div>
</section>
