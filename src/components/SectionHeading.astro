---
export interface Props {
  eyebrow?: string;
  title: string;
  desc?: string;
  dark?: boolean;
  align?: 'center' | 'left';
}

const { eyebrow, title, desc, dark = false, align = 'center' } = Astro.props;
const alignClass = align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl';
---

<div class={alignClass}>
  {eyebrow && (
    <span class={dark ? 'eyebrow-dark' : 'eyebrow'}>{eyebrow}</span>
  )}
  <h2 class={`mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-4xl ${dark ? 'text-white' : 'text-ink-900'}`}>
    <Fragment set:html={title} />
  </h2>
  {desc && (
    <p class={`mt-4 text-lg leading-relaxed ${dark ? 'text-white/70' : 'text-ink-700/80'}`}>{desc}</p>
  )}
</div>
