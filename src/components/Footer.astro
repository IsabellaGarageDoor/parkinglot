---
import { site } from '../data/site';
import { services } from '../data/services';
import { locations } from '../data/locations';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-ink-900 text-white">
  <div class="lane-line absolute inset-x-0 top-0 opacity-60"></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8 py-14">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2.5">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-brand-400 text-ink-900">
<!--            <Icon name="paint-roller" class="h-5 w-5" strokeWidth={2.4} /> -->
<img src="/photos/pavement-preservation-logo-exact.svg" alt="Pavement Preservation Logo" loading="lazy" />
          </span>
          <span class="font-display text-lg font-extrabold tracking-tight">
            Pavement <span class="text-brand-400">Preservation</span>
          </span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">
          Central Michigan asphalt maintenance — sealcoating, crack filling, line striping, pothole repair, signs, ADA
          compliance, and concrete repair. Dispatched from {site.homeBase}.
        </p>
        <div class="mt-5 flex flex-col gap-2 text-sm text-white/70">
          <a href={site.phoneHref} class="flex items-center gap-2 hover:text-brand-400">
            <Icon name="phone" class="h-4 w-4 text-brand-400" /> {site.phone}
          </a>
          <a href={site.emailHref} class="flex items-center gap-2 hover:text-brand-400">
            <Icon name="mail" class="h-4 w-4 text-brand-400" /> {site.email}
          </a>
        </div>
      </div>

      <div>
        <p class="font-display text-sm font-bold uppercase tracking-wider text-white/80">Services</p>
        <ul class="mt-4 space-y-2 text-sm text-white/60">
          {services.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="transition hover:text-brand-400">{s.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-display text-sm font-bold uppercase tracking-wider text-white/80">Service Areas</p>
        <ul class="mt-4 space-y-2 text-sm text-white/60">
          {locations.slice(0, 6).map((l) => (
            <li>
              <a href={`/locations/${l.slug}`} class="transition hover:text-brand-400">{l.city}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-display text-sm font-bold uppercase tracking-wider text-white/80">Company</p>
        <ul class="mt-4 space-y-2 text-sm text-white/60">
          <li><a href="/about" class="transition hover:text-brand-400">About</a></li>
          <li><a href="/contact" class="transition hover:text-brand-400">Contact</a></li>
          <li><a href="/services" class="transition hover:text-brand-400">All services</a></li>
          <li><a href="/locations" class="transition hover:text-brand-400">All service areas</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <p class="text-xs text-white/40">© {year} {site.dba}. All rights reserved.</p>
      <p class="text-xs text-white/40">A registered assumed name of Schwab & Co. Holdings LLC.</p>
      <p class="text-xs text-white/40">Licensed · Bonded · Insured · {site.license}</p>
    </div>
  </div>
</footer>
