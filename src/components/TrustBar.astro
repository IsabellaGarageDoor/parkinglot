---
import { trustItems } from '../data/site';
---

<div class="border-y border-ink-700/40 bg-ink-800 py-5">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="mb-3 text-center text-xs font-semibold uppercase tracking-[0.2em] text-white/40">
      Trusted by commercial properties across central Michigan
    </p>
    <div class="relative overflow-hidden">
      <div class="flex w-max animate-marquee gap-10">
        {[...trustItems, ...trustItems].map((t) => (
          <span class="font-display text-lg font-bold text-white/35 whitespace-nowrap">{t}</span>
        ))}
      </div>
    </div>
  </div>
</div>
