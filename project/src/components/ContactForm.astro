---
import Icon from './Icon.astro';
import { services } from '../data/services';

const supabaseUrl = import.meta.env.VITE_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.VITE_SUPABASE_ANON_KEY;
const hasSupabase = Boolean(supabaseUrl && supabaseAnonKey);
---

<div class="rounded-3xl border border-white/10 bg-white p-6 shadow-2xl shadow-black/40 sm:p-8">
  <form id="contact-form" class="space-y-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="name" class="mb-1.5 block text-sm font-semibold text-ink-900">Full name <span class="text-brand-500">*</span></label>
        <input id="name" name="name" type="text" required placeholder="Jane Doe" class="field" />
      </div>
      <div>
        <label for="email" class="mb-1.5 block text-sm font-semibold text-ink-900">Email <span class="text-brand-500">*</span></label>
        <input id="email" name="email" type="email" required placeholder="jane@company.com" class="field" />
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="phone" class="mb-1.5 block text-sm font-semibold text-ink-900">Phone (optional)</label>
        <input id="phone" name="phone" type="tel" placeholder="(989) 555-0123" class="field" />
      </div>
      <div>
        <label for="city" class="mb-1.5 block text-sm font-semibold text-ink-900">City / area</label>
        <input id="city" name="city" type="text" placeholder="Mt. Pleasant, MI" class="field" />
      </div>
    </div>

    <div>
      <label for="service" class="mb-1.5 block text-sm font-semibold text-ink-900">Service needed</label>
      <select id="service" name="service" class="field">
        <option value="">Select a service…</option>
        {services.map((s) => (
          <option value={s.title}>{s.title}</option>
        ))}
        <option value="Multiple / Not sure">Multiple / Not sure</option>
      </select>
    </div>

    <div>
      <label for="message" class="mb-1.5 block text-sm font-semibold text-ink-900">Project details <span class="text-brand-500">*</span></label>
      <textarea id="message" name="message" required rows="4" placeholder="Tell us about your lot — size, location, timeline, and any issues you're seeing." class="field"></textarea>
    </div>

    <div id="form-error" class="hidden rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700"></div>

    <button
      type="submit"
      id="form-submit"
      class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-400 px-6 py-3.5 text-base font-bold text-ink-900 shadow-lg shadow-brand-500/30 transition hover:bg-brand-300 disabled:cursor-not-allowed disabled:opacity-70"
    >
      <span data-label>Request free quote</span>
      <Icon name="arrow-right" class="h-4 w-4" />
    </button>

    <p class="text-center text-xs text-ink-700/60">
      We'll never share your information. Typical response within one business day.
    </p>
  </form>

  <div id="form-success" class="hidden flex-col items-center py-10 text-center">
    <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-brand-100 text-brand-600">
      <Icon name="check-circle" class="h-8 w-8" />
    </span>
    <h3 class="mt-5 font-display text-2xl font-bold text-ink-900">Request received</h3>
    <p class="mt-3 max-w-sm text-ink-700/80">
      Thanks — we'll review your lot details and reach out within 48 hours with a written quote.
      For urgent needs, call (989) 555-0142.
    </p>
    <button id="form-reset" type="button" class="mt-6 rounded-full bg-ink-900 px-6 py-2.5 text-sm font-bold text-white hover:bg-ink-800">
      Send another request
    </button>
  </div>
</div>

<script is:inline define:vars={{ hasSupabase, supabaseUrl, supabaseAnonKey }}>
  const form = document.getElementById('contact-form');
  const success = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');
  const submitBtn = document.getElementById('form-submit');
  const label = submitBtn.querySelector('[data-label]');
  const resetBtn = document.getElementById('form-reset');

  const params = new URLSearchParams(window.location.search);
  const preService = params.get('service');
  if (preService) {
    const select = document.getElementById('service');
    for (const opt of select.options) {
      if (opt.value === preService) {
        select.value = preService;
        break;
      }
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    submitBtn.disabled = true;
    label.textContent = 'Sending…';

    const data = new FormData(form);
    const payload = {
      name: String(data.get('name') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      phone: String(data.get('phone') ?? '').trim() || null,
      city: String(data.get('city') ?? '').trim() || null,
      service: String(data.get('service') ?? '').trim() || null,
      message: String(data.get('message') ?? '').trim(),
    };

    if (!payload.name || !payload.email || !payload.message) {
      errorEl.textContent = 'Please fill in your name, email, and a short message.';
      errorEl.classList.remove('hidden');
      submitBtn.disabled = false;
      label.textContent = 'Request free quote';
      return;
    }

    try {
      if (!hasSupabase) {
        await new Promise((r) => setTimeout(r, 600));
      } else {
        const res = await fetch(`${supabaseUrl}/rest/v1/contact_submissions`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: supabaseAnonKey,
            Authorization: `Bearer ${supabaseAnonKey}`,
            Prefer: 'return=minimal',
          },
          body: JSON.stringify(payload),
        });
        if (!res.ok && res.status !== 201) {
          throw new Error(`Request failed (${res.status})`);
        }
      }
      form.reset();
      form.classList.add('hidden');
      success.classList.remove('hidden');
      success.classList.add('flex');
    } catch (err) {
      errorEl.textContent = 'Something went wrong sending your request. Please call us at (989) 555-0142.';
      errorEl.classList.remove('hidden');
      submitBtn.disabled = false;
      label.textContent = 'Request free quote';
    }
  });

  resetBtn.addEventListener('click', () => {
    form.classList.remove('hidden');
    success.classList.add('hidden');
    success.classList.remove('flex');
    submitBtn.disabled = false;
    label.textContent = 'Request free quote';
  });
</script>
